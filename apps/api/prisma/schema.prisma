// Inventoryfy — Prisma schema
// Phase 1: tenancy skeleton (Business, User, Membership).
// Phase 3: catalog (Category, Product, ProductVariant, BundleComponent).
// Phase 4: warehouses (Warehouse, WarehouseStock, Transfer, CycleCount,
// CycleCountLine, Batch, SerialNumber).
// Phase 10: integrations (IntegrationConnection, IntegrationEventLog,
// Order.sourceConnectionId/externalOrderId) — external storefronts sync
// stock with Inventoryfy over a webhook/API-key contract.
// Every domain table carries `businessId` directly (denormalized, not just
// via joins) — this is the pattern later phases (warehouses, orders, POs)
// keep using so BusinessAccessGuard-style tenant scoping stays cheap.
//
// Stock model: ProductVariant.stock is a denormalized total kept in sync
// with WarehouseStock (the per-warehouse source of truth) by every mutating
// operation (adjust, transfer, cycle-count submit) in the same transaction.
// Stock that predates any warehouse existing (or a variant nobody has
// allocated yet) has no WarehouseStock row — it's surfaced as "Unallocated"
// wherever the per-warehouse breakdown is shown, rather than hidden.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A tenant. Each business is an isolated inventory/order/financial scope.
/// An "owner" user can hold OWNER memberships on several businesses at once
/// (drives the aggregate owner dashboard); a "staff" user is typically
/// scoped to a single business via one STAFF membership.
model Business {
  id        String   @id @default(cuid())
  name      String
  type      String? // free-form business category shown in the mockup (e.g. "Retail", "Wholesale")
  currency  String   @default("USD")
  timezone  String   @default("UTC")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships            Membership[]
  categories             Category[]
  products               Product[]
  variants               ProductVariant[]
  warehouses             Warehouse[]
  warehouseStocks        WarehouseStock[]
  transfers              Transfer[]
  cycleCounts            CycleCount[]
  batches                Batch[]
  serialNumbers          SerialNumber[]
  suppliers              Supplier[]
  supplierProducts       SupplierProduct[]
  purchaseOrders         PurchaseOrder[]
  orders                 Order[]
  returns                Return[]
  scheduledReports       ScheduledReport[]
  auditLogEntries        AuditLogEntry[]
  alertChannelSettings   AlertChannelSetting[]
  notificationLogEntries NotificationLogEntry[]
  integrationConnections IntegrationConnection[]
  integrationEventLogs   IntegrationEventLog[]

  @@map("businesses")
}

/// A login-capable account. Auth lives here; tenant access lives on Membership.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  /// Platform-operator flag, independent of any per-business Membership
  /// (see MembershipRole/TeamRole below, which are both business-scoped).
  /// Lets someone onboard a brand-new tenant Business and grant its
  /// first OWNER — by definition before any Membership on that business
  /// exists yet — and reassign/add an owner on an existing one. Nothing
  /// else in the app checks this; see PlatformModule + SuperOwnerGuard.
  isSuperOwner Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships Membership[]

  @@map("users")
}

enum MembershipRole {
  OWNER
  STAFF
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum TeamRole {
  OWNER
  BUSINESS_ADMIN
  INVENTORY_MANAGER
  SALES_STAFF
  ACCOUNTANT
}

/// Join table: which businesses a user can access, and with what role.
model Membership {
  id         String           @id @default(cuid())
  userId     String
  businessId String
  role       MembershipRole
  /// Finer-grained capability role (Phase 9), orthogonal to `role`: an
  /// OWNER membership is always teamRole=OWNER; a STAFF membership picks
  /// one of the other four at invite time. Drives the CAPABILITY_MATRIX
  /// in @inventoryfy/shared-types, not the login-mode / business-access
  /// logic that `role` still owns.
  teamRole   TeamRole         @default(SALES_STAFF)
  status     MembershipStatus @default(ACTIVE)
  invitedAt  DateTime?
  joinedAt   DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@map("memberships")
}

// ─── Catalog (Phase 3) ───────────────────────────────────────────────────

model Category {
  id         String   @id @default(cuid())
  businessId String
  name       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([businessId, name])
  @@map("categories")
}

model Product {
  id                String   @id @default(cuid())
  businessId        String
  name              String
  categoryId        String?
  description       String?
  imageUrl          String?
  /// Kits: selling one unit deducts each BundleComponent's own stock instead
  /// of tracking stock on the bundle itself.
  isBundle          Boolean  @default(false)
  lowStockThreshold Int      @default(10)
  /// GST/sales-tax rate applied to this product's line items (Phase 7).
  taxRatePercent    Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  business Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants ProductVariant[]

  /// Components this product is made of, when it's a bundle/kit.
  bundleComponents BundleComponent[] @relation("BundleParent")
  /// Bundles this product is used as a component of.
  usedInBundles    BundleComponent[] @relation("BundleComponentProduct")

  supplierLinks SupplierProduct[]

  @@index([businessId])
  @@map("products")
}

/// Every product has at least one variant — a simple (non-variant) product
/// gets a single "Default" variant so SKU/price/stock always live in one
/// place rather than two parallel code paths.
model ProductVariant {
  id         String   @id @default(cuid())
  businessId String
  productId  String
  label      String   @default("Default")
  sku        String
  price      Decimal  @default(0) @db.Decimal(12, 2)
  stock      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  warehouseStocks    WarehouseStock[]
  transfers          Transfer[]
  countLines         CycleCountLine[]
  batches            Batch[]
  serialNumbers      SerialNumber[]
  purchaseOrderItems PurchaseOrderItem[]
  orderItems         OrderItem[]

  @@unique([businessId, sku])
  @@map("product_variants")
}

model BundleComponent {
  id                 String @id @default(cuid())
  bundleProductId    String
  componentProductId String
  qty                Int    @default(1)

  bundleProduct    Product @relation("BundleParent", fields: [bundleProductId], references: [id], onDelete: Cascade)
  componentProduct Product @relation("BundleComponentProduct", fields: [componentProductId], references: [id], onDelete: Cascade)

  @@unique([bundleProductId, componentProductId])
  @@map("bundle_components")
}

// ─── Warehouses & inventory (Phase 4) ────────────────────────────────────

model Warehouse {
  id         String   @id @default(cuid())
  businessId String
  name       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business     Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  stockLevels  WarehouseStock[]
  cycleCounts  CycleCount[]
  transfersOut Transfer[]       @relation("TransferFrom")
  transfersIn  Transfer[]       @relation("TransferTo")
  orders       Order[]
  returns      Return[]
  /// Connections that fulfill their incoming external orders from here —
  /// see IntegrationConnection.defaultWarehouseId.
  integrationConnections IntegrationConnection[]

  @@map("warehouses")
}

/// Per-warehouse quantity for a variant — the source of truth for "where is
/// this stock". ProductVariant.stock is kept as a denormalized total.
model WarehouseStock {
  id          String @id @default(cuid())
  businessId  String
  warehouseId String
  variantId   String
  qty         Int    @default(0)

  business  Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, variantId])
  @@map("warehouse_stock")
}

enum TransferStatus {
  COMPLETED
}

model Transfer {
  id              String         @id @default(cuid())
  businessId      String
  variantId       String
  fromWarehouseId String
  toWarehouseId   String
  qty             Int
  status          TransferStatus @default(COMPLETED)
  createdAt       DateTime       @default(now())

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  fromWarehouse Warehouse      @relation("TransferFrom", fields: [fromWarehouseId], references: [id], onDelete: Cascade)
  toWarehouse   Warehouse      @relation("TransferTo", fields: [toWarehouseId], references: [id], onDelete: Cascade)

  @@map("transfers")
}

enum CycleCountStatus {
  IN_PROGRESS
  COMPLETED
}

model CycleCount {
  id          String           @id @default(cuid())
  businessId  String
  warehouseId String
  status      CycleCountStatus @default(IN_PROGRESS)
  createdAt   DateTime         @default(now())
  completedAt DateTime?

  business  Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  warehouse Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  lines     CycleCountLine[]

  @@map("cycle_counts")
}

model CycleCountLine {
  id           String @id @default(cuid())
  cycleCountId String
  variantId    String
  expected     Int
  counted      Int?

  cycleCount CycleCount     @relation(fields: [cycleCountId], references: [id], onDelete: Cascade)
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cycleCountId, variantId])
  @@map("cycle_count_lines")
}

model Batch {
  id         String    @id @default(cuid())
  businessId String
  variantId  String
  lotCode    String
  qty        Int
  expiryDate DateTime?
  createdAt  DateTime  @default(now())

  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@map("batches")
}

enum SerialStatus {
  IN_STOCK
  SOLD
  RETURNED
}

model SerialNumber {
  id            String       @id @default(cuid())
  businessId    String
  variantId     String
  serial        String
  status        SerialStatus @default(IN_STOCK)
  warrantyUntil DateTime?
  createdAt     DateTime     @default(now())

  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([businessId, serial])
  @@map("serial_numbers")
}

// ─── Suppliers & Purchase Orders (Phase 5) ───────────────────────────────

model Supplier {
  id           String   @id @default(cuid())
  businessId   String
  name         String
  category     String?
  leadTimeDays Int      @default(7)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business       Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  linkedProducts SupplierProduct[]
  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

/// Which products a supplier sells, and at what cost — powers both the
/// product page's "Linked suppliers" table and PO line-item cost defaults.
model SupplierProduct {
  id         String  @id @default(cuid())
  businessId String
  supplierId String
  productId  String
  costPrice  Decimal @default(0) @db.Decimal(12, 2)
  preferred  Boolean @default(false)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([supplierId, productId])
  @@map("supplier_products")
}

enum PoStatus {
  DRAFT
  SENT
  PARTIAL
  RECEIVED
  CLOSED
}

enum BillStatus {
  NONE
  UNPAID
  PARTIAL
  PAID
}

model PurchaseOrder {
  id           String     @id @default(cuid())
  businessId   String
  /// Business-scoped sequential number for the human-facing "PO-1002" id.
  number       Int
  supplierId   String
  status       PoStatus   @default(DRAFT)
  billStatus   BillStatus @default(NONE)
  expectedDate DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  sentAt       DateTime?
  receivedAt   DateTime?
  /// Set when billStatus transitions to PAID — dates the "Supplier
  /// payment" row in the transaction log.
  paidAt       DateTime?

  business Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplier Supplier            @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  items    PurchaseOrderItem[]

  @@unique([businessId, number])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String  @id @default(cuid())
  purchaseOrderId String
  variantId       String
  qty             Int
  unitCost        Decimal @default(0) @db.Decimal(12, 2)
  receivedQty     Int     @default(0)

  purchaseOrder PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@map("purchase_order_items")
}

// ─── Orders & Returns (Phase 6) ──────────────────────────────────────────

enum OrderChannel {
  WEBSITE
  AMAZON
  FLIPKART
}

enum OrderStatus {
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  BACKORDERED
}

/// Whether the customer has paid yet. Defaults PAID (the common case —
/// marketplace/website checkouts are paid upfront); flip to UNPAID for
/// invoiced/credit B2B orders, which is what feeds Accounts Receivable.
enum OrderPaymentStatus {
  PAID
  UNPAID
}

model Order {
  id            String             @id @default(cuid())
  businessId    String
  /// Business-scoped sequential number for the human-facing "ORD-5001" id.
  number        Int
  channel       OrderChannel
  customer      String
  status        OrderStatus        @default(PROCESSING)
  paymentStatus OrderPaymentStatus @default(PAID)
  note          String?
  warehouseId   String
  /// Set when this order was created by an external storefront via the
  /// Integrations API (Phase 10) rather than from inside Inventoryfy.
  /// Both null for every order created in-app, which is what makes them
  /// distinct from `undefined` in the @@unique below — Postgres treats
  /// NULL as never equal to NULL, so ordinary orders never collide.
  sourceConnectionId String?
  externalOrderId    String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  shippedAt     DateTime?
  deliveredAt   DateTime?
  cancelledAt   DateTime?

  business         Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  warehouse        Warehouse              @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  sourceConnection IntegrationConnection? @relation(fields: [sourceConnectionId], references: [id], onDelete: SetNull)
  items            OrderItem[]

  @@unique([businessId, number])
  /// Idempotency for the inbound integration webhook: a retried delivery
  /// with the same externalOrderId from the same connection is a no-op,
  /// not a duplicate order.
  @@unique([sourceConnectionId, externalOrderId])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  variantId String
  qty       Int
  unitPrice Decimal @default(0) @db.Decimal(12, 2)

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  returns Return[]

  @@map("order_items")
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  RECEIVED
  REFUNDED
}

model Return {
  id          String       @id @default(cuid())
  businessId  String
  /// Business-scoped sequential number for the human-facing "RMA-401" id.
  number      Int
  orderItemId String
  reason      String
  status      ReturnStatus @default(REQUESTED)
  /// null = not yet decided; set together with status -> REFUNDED.
  restock     Boolean?
  warehouseId String?
  createdAt   DateTime     @default(now())
  decidedAt   DateTime?

  business  Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orderItem OrderItem  @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  @@unique([businessId, number])
  @@map("returns")
}

// ─── Reports (Phase 8) ────────────────────────────────────────────────────

enum ReportType {
  VELOCITY
  TURNOVER
  DEAD_STOCK
}

enum ReportFrequency {
  WEEKLY
  MONTHLY
}

/// A saved "send me this report on a schedule" preference. Persisted for
/// real, but delivery (the actual email send) is infrastructure that
/// lands with Notifications (Phase 9) — this just remembers the ask.
model ScheduledReport {
  id         String          @id @default(cuid())
  businessId String
  reportType ReportType
  frequency  ReportFrequency
  email      String
  createdAt  DateTime        @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("scheduled_reports")
}

// ─── Team, Notifications & Audit (Phase 9) ───────────────────────────────

/// A generic mutating-request trail, written by a global interceptor
/// rather than instrumented into every service method by hand — every
/// POST/PATCH/PUT/DELETE under /businesses/:businessId/* gets one row.
model AuditLogEntry {
  id         String   @id @default(cuid())
  businessId String
  userId     String?
  userName   String
  userEmail  String
  action     String // HTTP method, e.g. "POST"
  entity     String // first meaningful route segment, e.g. "products"
  path       String
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@map("audit_log_entries")
}

enum AlertType {
  LOW_STOCK
  OUT_OF_STOCK
  NEW_ORDER
  SUPPLIER_BILL_OVERDUE
  PAYMENT_DUE
}

/// Per-business, per-alert-type channel configuration. Lazily defaulted
/// (matching the mockup's demo values) the first time a business's
/// settings are read, rather than requiring a seed step.
model AlertChannelSetting {
  id              String     @id @default(cuid())
  businessId      String
  alertType       AlertType
  emailEnabled    Boolean    @default(true)
  whatsappEnabled Boolean    @default(false)
  recipientRoles  TeamRole[]

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, alertType])
  @@map("alert_channel_settings")
}

enum NotificationChannel {
  EMAIL
  WHATSAPP
}

enum NotificationDeliveryStatus {
  SENT
  FAILED
}

/// A record of what *would* have been sent for a given alert — there's no
/// SMTP/WhatsApp integration behind this, so SENT means "a channel was
/// enabled and had at least one eligible recipient", not "delivered".
model NotificationLogEntry {
  id         String                     @id @default(cuid())
  businessId String
  alertType  AlertType
  channel    NotificationChannel
  recipient  String
  status     NotificationDeliveryStatus
  createdAt  DateTime                   @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("notification_log_entries")
}

// ─── Integrations (Phase 10) ──────────────────────────────────────────────
// A registered external storefront — an independently-run e-commerce app,
// not part of this codebase — syncs stock with Inventoryfy the same way a
// channel connects to Zoho Inventory: Inventoryfy issues an API key the
// storefront calls in with (inbound orders), and stores a webhook URL +
// signing secret Inventoryfy calls back out on (outbound stock changes).
// Inventoryfy is the single source of truth; the storefront never owns
// stock itself.

enum IntegrationConnectionStatus {
  ACTIVE
  PAUSED
}

model IntegrationConnection {
  id         String                       @id @default(cuid())
  businessId String
  name       String
  status     IntegrationConnectionStatus  @default(ACTIVE)
  /// SHA-256 of the plaintext API key — only the hash is ever stored. The
  /// plaintext is shown once at creation time, the same pattern as a
  /// GitHub/Stripe API key.
  apiKeyHash     String @unique
  /// Last 4 characters of the plaintext key, kept only so the owner can
  /// tell connections apart later ("sk_live_...ab12").
  apiKeyLastFour String
  webhookUrl     String
  /// Used to HMAC-sign outbound webhook payloads so the storefront can
  /// verify a delivery actually came from Inventoryfy and not an impostor.
  webhookSecret String
  /// Which warehouse this connection's incoming orders are fulfilled
  /// from — an external storefront has no concept of Inventoryfy's
  /// warehouses, so this is chosen once at connection time.
  defaultWarehouseId String
  createdAt          DateTime @default(now())

  business  Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [defaultWarehouseId], references: [id], onDelete: Restrict)
  orders    Order[]
  events    IntegrationEventLog[]

  @@map("integration_connections")
}

enum IntegrationDirection {
  INBOUND
  OUTBOUND
}

enum IntegrationEventType {
  ORDER_RECEIVED
  ORDER_CANCELLED
  INVENTORY_UPDATED
}

enum IntegrationEventStatus {
  SUCCESS
  FAILED
}

/// One row per inbound order processed or outbound webhook delivery
/// attempted — the sync log a connection's health is actually judged by,
/// same "make failures visible" principle as the Phase 9 audit log.
model IntegrationEventLog {
  id           String                  @id @default(cuid())
  businessId   String
  connectionId String
  direction    IntegrationDirection
  eventType    IntegrationEventType
  status       IntegrationEventStatus
  payload      Json
  errorMessage String?
  attempts     Int                     @default(1)
  createdAt    DateTime                @default(now())

  business   Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@map("integration_event_logs")
}
